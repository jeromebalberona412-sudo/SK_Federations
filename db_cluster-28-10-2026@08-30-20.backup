-- Name: official_profiles; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.official_profiles (
    id bigint NOT NULL,
    user_id bigint NOT NULL,
    first_name character varying(150) NOT NULL,
    last_name character varying(150) NOT NULL,
    middle_name character varying(150),
    suffix character varying(20),
    "position" character varying(255) NOT NULL,
    municipality character varying(255) DEFAULT 'Santa Cruz'::character varying NOT NULL,
    province character varying(255) DEFAULT 'Laguna'::character varying NOT NULL,
    region character varying(255) DEFAULT 'IV-A CALABARZON'::character varying NOT NULL,
    created_at timestamp(0) without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_at timestamp(0) without time zone,
    tenant_id bigint,
    date_of_birth date,
    age smallint,
    contact_number character varying(20),
    sex character varying(10),
    federation_position character varying(255),
    CONSTRAINT official_profiles_position_check CHECK ((("position")::text = ANY ((ARRAY['President'::character varying, 'Vice President'::character varying, 'Secretary'::character varying, 'Treasurer'::character varying, 'PIO'::character varying, 'Sergeant at Arms'::character varying, 'Chairperson'::character varying, 'Kagawad'::character varying, 'Councilor'::character varying, 'Auditor'::character varying])::text[])))
);


ALTER TABLE public.official_profiles OWNER TO postgres;

