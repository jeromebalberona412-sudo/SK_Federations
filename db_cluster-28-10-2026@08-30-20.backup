    email_verified_at timestamp(0) without time zone,
    password character varying(255) NOT NULL,
    remember_token character varying(100),
    created_at timestamp(0) without time zone,
    updated_at timestamp(0) without time zone,
    tenant_id bigint,
    barangay_id bigint,
    pending_email character varying(255),
    email_change_token character varying(255),
    email_change_token_expires_at timestamp(0) without time zone,
    email_change_verified_at timestamp(0) without time zone,
    email_change_last_sent_at timestamp(0) without time zone,
    pending_password character varying(255),
    password_change_token character varying(255),
    password_change_token_expires_at timestamp(0) without time zone,
    password_change_last_sent_at timestamp(0) without time zone,
    must_change_password boolean DEFAULT false NOT NULL,
    profile_image_url text,
    profile_image_public_id character varying(255),
    profile_image_uploaded_at timestamp(0) without time zone,
    profile_image_change_available_at timestamp(0) without time zone,
    role character varying(30) DEFAULT 'kabataan'::character varying NOT NULL,
    status character varying(30) DEFAULT 'ACTIVE'::character varying NOT NULL,
    online_status character varying(20) DEFAULT 'offline'::character varying NOT NULL,
    active_session_id character varying(255),
    last_seen timestamp(0) without time zone,
    active_device character varying(255),
    last_ip character varying(45),
    lockout_count integer DEFAULT 0 NOT NULL,
    lockout_until timestamp(0) without time zone,
    last_login_at timestamp(0) without time zone,
    last_login_ip character varying(45),
    deleted_at timestamp(0) without time zone,
    has_federation_access boolean DEFAULT false NOT NULL,
    account_status character varying(40),
    turnover_status character varying(40),
    activated_term_id bigint,
    turnover_notice_dismissed_until timestamp(0) without time zone
);


ALTER TABLE public.users OWNER TO postgres;

--
-- Name: deleted_sk_federations; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.deleted_sk_federations AS
 SELECT u.id,
    u.tenant_id,
    u.barangay_id,
    u.name,
    u.email,
    u.status,
    u.email_verified_at,
    u.deleted_at,
    op.first_name,
    op.middle_name,
    op.last_name,
    op.suffix,
    op.sex,
    op.date_of_birth,
    op.age,
    op.contact_number,
    op."position",
    op.municipality,
    op.province,
    op.region
   FROM (public.users u
     LEFT JOIN public.official_profiles op ON ((op.user_id = u.id)))
  WHERE ((u.deleted_at IS NOT NULL) AND ((u.role)::text = 'sk_fed'::text));


ALTER VIEW public.deleted_sk_federations OWNER TO postgres;

