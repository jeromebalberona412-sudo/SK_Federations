    aaguid uuid,
    sign_count bigint DEFAULT 0 NOT NULL,
    transports jsonb DEFAULT '[]'::jsonb NOT NULL,
    backup_eligible boolean DEFAULT false NOT NULL,
    backed_up boolean DEFAULT false NOT NULL,
    friendly_name text DEFAULT ''::text NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    last_used_at timestamp with time zone
);


ALTER TABLE auth.webauthn_credentials OWNER TO supabase_auth_admin;

--
-- Name: abyip; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.abyip (
    id bigint NOT NULL,
    document_id bigint,
    tenant_id bigint,
    barangay_id bigint NOT NULL,
    created_by bigint,
    fiscal_year smallint NOT NULL,
    country character varying(100) DEFAULT 'Republic of the Philippines'::character varying NOT NULL,
    region character varying(100),
    province character varying(100),
    municipality character varying(100),
    barangay_name character varying(255),
    document_title character varying(255) DEFAULT ''::character varying NOT NULL,
    sk_council_name character varying(255),
    barangay_estimated_budget numeric(15,2) DEFAULT '0'::numeric NOT NULL,
    sk_fund_percentage numeric(5,2) DEFAULT '10'::numeric NOT NULL,
    sk_fund_amount numeric(15,2) DEFAULT '0'::numeric NOT NULL,
    total_budget numeric(15,2),
    prepared_by character varying(255),
    prepared_position character varying(255),
    prepared_by_user_id bigint,
    approved_by character varying(255),
    approved_position character varying(255),
    approved_by_user_id bigint,
    source_type character varying(20) DEFAULT 'word'::character varying NOT NULL,
    document_html text,
    pdf_data text,
    row_type character varying(30) DEFAULT 'document'::character varying NOT NULL,
    parent_id bigint,
    code character varying(20),
    program_name text,
    description text,
    expected_result text,
    performance_indicator text,
    implementation_period text,
    person_responsible text,
    mooe numeric(15,2),
    co numeric(15,2),
    total numeric(15,2),
    budget numeric(15,2),
    sort_order integer,
    created_at timestamp(0) without time zone,
    updated_at timestamp(0) without time zone,
    status character varying(30),
    prepared_by_name character varying(255),
    prepared_by_position character varying(255),
    approved_by_name character varying(255),
    approved_by_position character varying(255),
    reviewed_at timestamp(0) without time zone,
    reviewed_by_user_id bigint,
    rejection_reason text,
    category text,
    activity_name text,
    implementation_start date,
    implementation_end date,
    progress_percent numeric(5,2),
    accomplishment_status character varying(50),
    target_date date,
    completed_at timestamp(0) without time zone,
    submitted_at timestamp(0) without time zone,
    approved_at timestamp(0) without time zone,
    rejected_at timestamp(0) without time zone,
    source_text text,
    page_number smallint,
    extraction_confidence numeric(5,2),
    extraction_status character varying(30),
    manual_review_required boolean DEFAULT false NOT NULL,
    validation_status character varying(30),
    validation_message text,
    last_edited_by bigint,
    last_edited_at timestamp(0) without time zone,
    edit_reason text,
    CONSTRAINT chk_abyip_row_type CHECK (((row_type)::text = ANY (ARRAY['document'::text, 'category'::text, 'expenditure'::text, 'youth_program'::text, 'activity'::text, 'manual_program'::text])))
);


ALTER TABLE public.abyip OWNER TO postgres;

