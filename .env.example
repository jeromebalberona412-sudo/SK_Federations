APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=db.your-supabase-project.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=sk_federations_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

SK_FED_TENANT_CODE=santa_cruz
SK_FED_REQUIRED_ROLE=sk_fed
# Bootstrap super admin: skoneportal@gmail.com (run php artisan skfed:ensure-bootstrap-admin)
SK_FED_ENFORCE_TRUSTED_DEVICE=true
SK_FED_TRUSTED_DEVICE_EXPIRATION_DAYS=30
SK_FED_LOGIN_WINDOW_MINUTES=15
SK_FED_LOGIN_MAX_FAILURES=5
SK_FED_LOGIN_MAX_LOCK_MINUTES=60
SK_FED_FEATURE_DEVICE_VERIFICATION=true
SK_FED_FEATURE_LOGIN_ALERTS=true
SK_FED_FEATURE_SUSPICIOUS_LOGIN=true
SK_FED_HEARTBEAT_INTERVAL_SECONDS=30
SK_FED_HEARTBEAT_TIMEOUT_SECONDS=120
SK_FED_OTP_EXPIRATION_MINUTES=5
SK_FED_OTP_MAX_ATTEMPTS=5
SK_FED_OTP_RESEND_COOLDOWN_SECONDS=60

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Portal URLs used in batch/manual account invitation emails (password setup link)
# SK Federations creates SK Official accounts — link must point to SK Officials login/reset page.
SK_OFFICIALS_APP_URL=https://darksalmon-barracuda-480728.hostingersite.com
SK_FED_APP_URL=https://palevioletred-mule-147734.hostingersite.com

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

SK_FED_PASSWORD_RESET_IP_PER_MINUTE=5
SK_FED_PASSWORD_RESET_EMAIL_PER_HOUR=10
SK_FED_PASSWORD_RESET_FORM_PER_MINUTE=20
SK_FED_PASSWORD_RESET_MIN_LENGTH=12
SK_FED_PASSWORD_RESET_MAX_LENGTH=64

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sk_oneportal/sk_fed_posts
